@mode(host.dual)

# Top level of where: parse the arguments, handle /? and --version, run the
# search and turn the outcome into where's ERRORLEVEL.
#
# Runtime: host.dual. Compiled into the native binary build/where by `make
# build`; `loup run source/main.loup` interprets the same code, and the unit
# tests call run() directly.

from appinfo import (EXIT_FOUND, EXIT_ERROR);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.wherefile import (run_where);

# Parses argv, runs where and returns the exit status (where's ERRORLEVEL).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(msg);
            return EXIT_ERROR;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_FOUND;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_FOUND;
    }

    try {
        return run_where(opts);
    } catch (Exception as e) {
        printErr("ERROR: " + e.message);
        return EXIT_ERROR;
    }
}
