@mode(host.dual)

# Command-line parsing for where, following the Windows switch convention in
# win/switches.loup:
#
#   WHERE [/R dir] [/Q] [/F] [/T] pattern...
#
# Switches are case-insensitive and start with `/` or `-`; `--` ends switch
# parsing. Error messages use the wording of where.exe's command-line
# parser, followed by `Type "WHERE /?" for usage.`

from win.switches import (SwitchArgs, SwitchSpec, flag, required_value, parse_switches,
    switch_value);

pub const MSG_TYPE_HELP: string = "Type \"WHERE /?\" for usage.";

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub recurse: bool;         # /R given
    pub root: string;          # the /R directory as typed
    pub quiet: bool;           # /Q
    pub quote: bool;           # /F
    pub patterns: list[string];
}

pub func where_switches(): list[SwitchSpec] {
    return [required_value("R"), flag("Q"), flag("F"), flag("T")];
}

# A usage error: the message and the line that points to the help.
pub func usage_error(message: string): string {
    return "ERROR: " + message + "\n" + MSG_TYPE_HELP;
}

# Whether an argument looks like an option: `/x` or `-x`, and not a
# `path:pattern` (`/usr/bin:ls`).
func looks_like_option(arg: string): bool {
    return arg.len() >= 2 and (arg.startsWith("/") or arg.startsWith("-")) and arg.index_of(":") < 0;
}

# The arguments before the first `--`.
func before_double_dash(argv: list[string]): list[string] {
    var out: list[string] = [];
    for (a in argv) {
        if (a == "--") {
            break;
        }
        out.push(a);
    }
    return out;
}

# The first switch given more than once, as typed, or "".
func repeated_switch(parsed: SwitchArgs): string {
    var seen: list[string] = [];
    for (sw in parsed.switches) {
        if (seen.contains(sw.name)) {
            return sw.text;
        }
        seen.push(sw.name);
    }
    return "";
}

# The statement form of `match` (arms that return) is deliberate: a match
# expression whose arms build new values returns freed memory natively.
pub func parse_args(argv: list[string]): Result[Options, string] {
    let parsed = match parse_switches(argv, where_switches()) {
        Ok(p) => p,
        Err(e) => {
            return Err(usage_error("Invalid syntax. Value expected for '" + e.text + "'."));
        },
    };
    if (parsed.help or parsed.version) {
        return Ok(Options(help = parsed.help, version = parsed.version, recurse = false,
            root = "", quiet = false, quote = false, patterns = parsed.operands));
    }

    # Before `--`, an argument that looks like an option but is not one of
    # where's is an error, as in where.exe.
    let early = match parse_switches(before_double_dash(argv), where_switches()) {
        Ok(p) => p,
        Err(e) => {
            return Err(usage_error("Invalid syntax. Value expected for '" + e.text + "'."));
        },
    };
    for (op in early.operands) {
        if (looks_like_option(op)) {
            return Err(usage_error("Invalid argument/option - '" + op + "'."));
        }
    }
    let twice = repeated_switch(parsed);
    if (twice.len() > 0) {
        return Err(usage_error("Invalid syntax. '" + twice + "' option is not allowed more than '1' time(s)."));
    }
    if (parsed.operands.len() == 0) {
        return Err(usage_error("Invalid syntax."));
    }
    var has_t = false;
    var has_r = false;
    var has_q = false;
    var has_f = false;
    for (sw in parsed.switches) {
        if (sw.name == "T") {
            has_t = true;
        } else if (sw.name == "R") {
            has_r = true;
        } else if (sw.name == "Q") {
            has_q = true;
        } else if (sw.name == "F") {
            has_f = true;
        }
    }
    if (has_t) {
        return Err("ERROR: /T is not supported: Loup 1.26.0 cannot read file sizes and times.");
    }
    return Ok(Options(
        help = false,
        version = false,
        recurse = has_r,
        root = switch_value(parsed, "R") ?? "",
        quiet = has_q,
        quote = has_f,
        patterns = parsed.operands,
    ));
}
