@mode(host.dual)

# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "where";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Find files on PATH or under a directory by pattern (a Loup recreation of the Windows where command).";

# Exit statuses returned by main(), as where.exe sets ERRORLEVEL.
pub const EXIT_FOUND: int = 0;      # at least one file was found
pub const EXIT_NOT_FOUND: int = 1;  # nothing matched
pub const EXIT_ERROR: int = 2;      # bad arguments or another error
