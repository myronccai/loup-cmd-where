@mode(host.dual)

# Unit tests for where's exit statuses over whole command lines
# (cli.app.run). These tests print the program's normal output.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the binary.
# The files it searches are created under build/tmp/ (removed by `make
# clean`).

from debug.assert import (expectEq);
from io.fs import (createDir, writeText, removeDir, isDir);
from appinfo import (EXIT_FOUND, EXIT_NOT_FOUND, EXIT_ERROR);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_FOUND, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["/?"]), EXIT_FOUND, "/?");
}

func test_usage_error(): void {
    expectEq(run(["/bogus"]), EXIT_ERROR, "unknown option");
}

func test_recursive_search(): void {
    let root = "build/tmp/app_where";
    if (isDir(root)) {
        removeDir(root);
    }
    createDir(root);
    createDir(root + "/sub");
    writeText(root + "/sub/found.txt", "x\n");
    expectEq(run(["/R", root, "found.txt"]), EXIT_FOUND, "found");
    expectEq(run(["/R", root, "/Q", "missing.txt"]), EXIT_NOT_FOUND, "not found");
    expectEq(run(["/R", root + "/none", "x"]), EXIT_ERROR, "no such directory");
    removeDir(root);
}
