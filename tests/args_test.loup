@mode(host.dual)

# Unit tests for where's argument parsing (cli.args): switches, /R's
# directory, `path:pattern` operands and where.exe's usage errors.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, where_switches, MSG_TYPE_HELP);

func same(got: string, want: string, what: string): void {
    expect(got == want, what + ": got '" + got + "', want '" + want + "'");
}

func test_patterns_and_switches(): void {
    let opts = parse_args(["/q", "ls", "-F", "*.sh"]).unwrap();
    expect(opts.quiet and opts.quote and !opts.recurse, "/q -F");
    same(opts.patterns.join(","), "ls,*.sh", "patterns");
}

func test_declared_switches(): void {
    expectEq(where_switches().len(), 4, "R Q F T");
}

func test_recursive_dir(): void {
    let opts = parse_args(["/R", "src", "*.c"]).unwrap();
    expect(opts.recurse, "/R");
    same(opts.root, "src", "directory");
    same(opts.patterns.join(","), "*.c", "pattern");
    same(parse_args(["/r:/tmp", "x"]).unwrap().root, "/tmp", "/r:dir");
}

func test_path_pattern_is_not_an_option(): void {
    same(parse_args(["/usr/bin:ls"]).unwrap().patterns[0], "/usr/bin:ls", "path:pattern");
}

func test_errors(): void {
    same(parse_args(["/x"]).unwrap_err(),
        "ERROR: Invalid argument/option - '/x'.\n" + MSG_TYPE_HELP, "unknown option");
    same(parse_args(["/R"]).unwrap_err(),
        "ERROR: Invalid syntax. Value expected for '/R'.\n" + MSG_TYPE_HELP, "no /R value");
    same(parse_args(["/Q", "-q", "x"]).unwrap_err(),
        "ERROR: Invalid syntax. '-q' option is not allowed more than '1' time(s).\n" + MSG_TYPE_HELP,
        "repeated");
    let none: list[string] = [];
    same(parse_args(none).unwrap_err(), "ERROR: Invalid syntax.\n" + MSG_TYPE_HELP, "no pattern");
    expect(parse_args(["/T", "x"]).unwrap_err().startsWith("ERROR: /T is not supported"), "/T");
}

func test_double_dash(): void {
    let opts = parse_args(["--", "-x", "/?"]).unwrap();
    expect(!opts.help, "/? after --");
    same(opts.patterns.join(","), "-x,/?", "patterns after --");
}

func test_help_and_version(): void {
    expect(parse_args(["/?"]).unwrap().help, "/?");
    expect(parse_args(["/x", "-?"]).unwrap().help, "-? wins");
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["--version"]).unwrap().version, "--version");
}
